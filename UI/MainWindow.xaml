<Window x:Class="HDRReset.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDR 自动刷新 - 适用于 Legion Pro27UD10"
        Width="1000"
        Height="620"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Foreground="White"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- 按钮样式 -->
        <!-- ===================================================== -->

        <Style x:Key="LargeButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#242424"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#555555"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#363636"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#484848"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- DataGrid -->
        <!-- ===================================================== -->

        <Style TargetType="DataGrid">

            <!-- 表格整体固定宽度 -->
            <Setter Property="Width"
                    Value="540"/>

            <Setter Property="Background"
                    Value="Black"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#454545"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="RowBackground"
                    Value="Black"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#101010"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#454545"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#454545"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserResizeColumns"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="False"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>

            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <!-- ================================================= -->
            <!-- 根本禁止滚动条 -->
            <!-- ================================================= -->

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Disabled"/>

        </Style>


        <!-- ===================================================== -->
        <!-- DataGrid 行 -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="Black"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Height"
                    Value="46"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#363636"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 表头样式 -->
        <!-- ===================================================== -->

        <Style x:Key="CenteredHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#242424"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#454545"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <!-- ===================================================== -->
        <!-- 数据文字居中 -->
        <!-- ===================================================== -->

        <Style x:Key="CenteredCellTextStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

        </Style>


        <!-- ===================================================== -->
        <!-- 单元格 -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- 主界面 -->
    <!-- ========================================================= -->

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 使用说明 + 按钮 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,12">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <TextBlock
                Grid.Row="0"
                Text="使用说明&#x0A;&#x0A;• 每 30 分钟自动刷新一次 HDR。&#x0A;• 按数字键 1 可立即刷新 HDR，并重新计时 30 分钟。"
                FontSize="15"
                Foreground="White"
                LineHeight="21"
                Margin="0,0,0,10"/>


            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal">

                <Button
                    Content="刷新 HDR"
                    Width="180"
                    Height="50"
                    Style="{StaticResource LargeButtonStyle}"
                    Click="RefreshButton_Click"
                    Margin="0,0,14,0"/>

                <Button
                    Content="结束程序"
                    Width="140"
                    Height="50"
                    Style="{StaticResource LargeButtonStyle}"
                    Click="ExitButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- 刷新记录 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <TextBlock
                Grid.Row="0"
                Text="刷新记录"
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Margin="0,0,0,7"/>


            <TextBlock
                x:Name="ErrorLabel"
                Grid.Row="1"
                Text=""
                FontSize="14"
                Foreground="Red"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                Margin="0,0,0,6"/>


            <!-- ================================================= -->
            <!-- 日志表格 -->
            <!-- ================================================= -->

            <DataGrid
                x:Name="LogGrid"
                Grid.Row="2">

                <DataGrid.Columns>

                    <!-- ================================================= -->
                    <!-- 刷新时间 -->
                    <!-- ================================================= -->

                    <DataGridTextColumn
                        Header="刷新时间"
                        Binding="{Binding RefreshTime}"
                        Width="170*"
                        HeaderStyle="{StaticResource CenteredHeaderStyle}"
                        ElementStyle="{StaticResource CenteredCellTextStyle}"/>


                    <!-- ================================================= -->
                    <!-- 类型 -->
                    <!-- ================================================= -->

                    <DataGridTextColumn
                        Header="类型"
                        Binding="{Binding RefreshType}"
                        Width="120*"
                        HeaderStyle="{StaticResource CenteredHeaderStyle}"
                        ElementStyle="{StaticResource CenteredCellTextStyle}"/>


                    <!-- ================================================= -->
                    <!-- 下一次刷新时间 -->
                    <!-- ================================================= -->

                    <DataGridTextColumn
                        Header="下一次刷新时间"
                        Binding="{Binding NextRefreshTime}"
                        Width="250*"
                        HeaderStyle="{StaticResource CenteredHeaderStyle}"
                        ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>